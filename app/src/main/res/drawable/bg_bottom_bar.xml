<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- BASE redondeada con gradiente -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#66D2F8"
                android:endColor="#1F2F80"
                android:angle="0" />
            <corners
                android:bottomLeftRadius="26dp"
                android:bottomRightRadius="26dp"
                android:topLeftRadius="10dp"
                android:topRightRadius="10dp" />
        </shape>
    </item>

    <!-- BANDA diagonal superior (brillo) -->
    <item android:gravity="top">
        <rotate
            android:fromDegrees="-6"
            android:toDegrees="-6"
            android:pivotX="50%"
            android:pivotY="0%">
            <shape android:shape="rectangle">
                <gradient
                    android:startColor="#33FFFFFF"
                    android:endColor="#001C3F80"
                    android:angle="270" />
                <size android:height="18dp" />

            </shape>
        </rotate>
    </item>

</layer-list>

